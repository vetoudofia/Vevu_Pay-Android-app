{
  "name": "vevupay-mobile",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "cap:add:android": "npm run build:mobile && cap add android && npm run assets:android && npm run android:prepare && cap sync android",
    "cap:sync:android": "npm run build:mobile && npm run android:prepare && cap sync android",
    "cap:open:android": "cap open android",
    "android:debug": "npm run cap:sync:android && cd android && ./gradlew assembleDebug",
    "assets:android": "capacitor-assets generate --android",
    "android:apk:release": "npm run cap:sync:android && cd android && ./gradlew assembleRelease",
    "android:aab:release": "npm run cap:sync:android && cd android && ./gradlew bundleRelease",
    "android:prepare": "node scripts/prepare-android.mjs"
  },
